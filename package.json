{
  "name": "indian-bank-login",
  "version": "1.0.0",
  "description": "Indian Bank Login Page with comprehensive test suite",
  "main": "src/main/webapp/js/login.js",
  "scripts": {
    "test": "jest --verbose --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=html"
  },
  "keywords": [
    "login",
    "authentication",
    "banking",
    "indian-bank"
  ],
  "author": "Indian Bank Development Team",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/main/webapp/js/**/*.js",
      "!src/main/webapp/js/**/*.test.js"
    ],
    "testMatch": [
      "**/src/main/webapp/js/**/*.test.js"
    ],
    "setupFilesAfterEnv": [],
    "verbose": true
  }
}

